#!/usr/bin/env bash
# ios6-shell — launch the iOS 6 SpringBoard as a fullscreen Wayland kiosk.
#
# Runs cage (a single-window Wayland compositor) with a browser in kiosk
# mode pointed at the shell. Meant to be started from a TTY (autologin)
# or by ios6-shell.service; the browser IS the session.
#
# Browser preference: chromium (Arch), then epiphany/WebKitGTK — the
# latter lets minimal test images without chromium still boot the shell.
set -euo pipefail

UI="${IOS6_UI:-/usr/share/ios6/index.html}"
URL="file://${UI}?kiosk=1"

# prefer the loopback HTTP server built into ios6d: query strings survive
# (WebKit strips them from file:// URLs) and the system bridge is same-origin
if command -v ios6d >/dev/null; then
    if ! (exec 3<>/dev/tcp/127.0.0.1/9641) 2>/dev/null; then
        ios6d >>/var/log/ios6d.log 2>&1 &
        disown || true
    fi
    for _ in $(seq 1 20); do
        if (exec 3<>/dev/tcp/127.0.0.1/9641) 2>/dev/null; then
            URL="http://127.0.0.1:9641/index.html?kiosk=1"
            break
        fi
        sleep 0.2
    done
fi

if ! command -v cage >/dev/null; then
    echo "ios6-shell: cage is not installed (pacman -S cage)" >&2
    exit 1
fi

# a runtime dir is required by Wayland; logind normally provides it
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# be tolerant of GPUs with no GL (VMs, old hardware): software rendering
export WLR_RENDERER="${WLR_RENDERER:-pixman}"
export LIBGL_ALWAYS_SOFTWARE=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1

if BROWSER="$(command -v chromium || command -v chromium-browser)"; then
    # persistent profile on installed systems so notes/settings/installed
    # apps survive reboots; tmpfs fallback on read-only live media
    PROFILE=/var/lib/ios6/chromium
    if ! mkdir -p "$PROFILE" 2>/dev/null || ! touch "$PROFILE/.w" 2>/dev/null; then
        PROFILE="$XDG_RUNTIME_DIR/ios6-chromium"
        mkdir -p "$PROFILE"
    fi
    rm -f "$PROFILE/.w" 2>/dev/null || true
    exec cage -- "$BROWSER" \
        --kiosk \
        --app="$URL" \
        --user-data-dir="$PROFILE" \
        --no-first-run \
        --noerrdialogs \
        --disable-infobars \
        --disable-session-crashed-bubble \
        --autoplay-policy=no-user-gesture-required \
        --disable-gpu \
        --ozone-platform=wayland
elif BROWSER="$(command -v epiphany)"; then
    # plain window in a private profile — epiphany's application mode
    # requires full web-app installation state (epiphany#713), and cage
    # fullscreens the window regardless
    PROFILE="$XDG_RUNTIME_DIR/ios6-profile"
    mkdir -p "$PROFILE"
    exec cage -- "$BROWSER" --profile="$PROFILE" "$URL"
else
    echo "ios6-shell: no browser found (pacman -S chromium, or apt install epiphany-browser)" >&2
    exit 1
fi
