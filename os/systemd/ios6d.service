[Unit]
Description=iOS 6 shell system bridge (battery, Wi-Fi, ModemManager)
After=network.target
Wants=ModemManager.service NetworkManager.service

[Service]
ExecStart=/usr/bin/ios6d
Restart=on-failure
RestartSec=2
# lets Cydia's Search tab install real packages via pacman; remove to disable
Environment=IOS6D_ALLOW_INSTALL=1
# loopback-only HTTP; needs system access for nmcli/mmcli/sysfs
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
